{
    "name": "otten-it/version-report",
    "description": "Lets a monitoring dashboard read which Laravel, PHP and package versions a Laravel application runs on, behind a secret token.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "versions",
        "monitoring",
        "security",
        "hosting",
        "end-of-life"
    ],
    "homepage": "https://www.otten-it.nl",
    "authors": [
        {
            "name": "Otten IT",
            "homepage": "https://www.otten-it.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/otten-it/version-report/issues",
        "source": "https://github.com/otten-it/version-report",
        "security": "https://github.com/otten-it/version-report/blob/main/SECURITY.md"
    },
    "require": {
        "php": "^8.3",
        "illuminate/support": "^12.0|^13.0",
        "illuminate/routing": "^12.0|^13.0",
        "composer-runtime-api": "^2.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.5"
    },
    "autoload": {
        "psr-4": {
            "OttenIt\\VersionReport\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OttenIt\\VersionReport\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "OttenIt\\VersionReport\\VersionReportServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
